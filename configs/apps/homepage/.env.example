# Copy to .env, fill in, then: chmod 600 .env
# Homepage substitutes {{HOMEPAGE_VAR_...}} in config files with these values.
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_PIHOLE_KEY=
# Dedicated Proxmox user/token with the read-only PVEAuditor role
HOMEPAGE_VAR_PROXMOX_USER=api@pam!homepage
HOMEPAGE_VAR_PROXMOX_SECRET=
